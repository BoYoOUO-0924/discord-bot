# 複製成 .env（和 bot.py 同一層）並填入你的設定
# .env 已被 .gitignore 排除，不會上傳到 GitHub，自動更新也不會動到它
# 格式：名稱=值，等號兩邊不用空格，值不用加引號；# 開頭是註解

# ===== 必填 =====
# Discord Bot Token（Discord Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# ===== 海龜湯的 AI 湯主（二選一，都沒設定的話海龜湯會停用，其他功能照常）=====
# 選項 1：Ollama（自己架的模型，可以透過 Tailscale 連到別台電腦）
# OLLAMA_URL=http://100.123.111.120:11434
# OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
# 選項 2：Gemini（Google 雲端；新專案可能需要開啟付費）
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-flash-latest
# 兩個都有設定時預設用 Ollama；想指定的話設定 AI_PROVIDER=ollama 或 AI_PROVIDER=gemini

# ===== 每日天氣預報（兩個都填才會啟用）=====
# 中央氣象署開放資料平台的 API 授權碼：https://opendata.cwa.gov.tw → 登入 → 取得授權碼
CWA_API_KEY=YOUR_CWA_API_KEY
# 要傳送預報的 Discord Webhook：編輯頻道 → 整合 → Webhook → 新 Webhook → 複製 Webhook 網址
WEATHER_WEBHOOK_URL=YOUR_WEBHOOK_URL
# 傳送時間（台灣時間），預設 06:00
# WEATHER_TIME=06:00

# ===== 選填：管理後台 =====
# 密碼至少 8 個字元。設定後可以用瀏覽器開 http://這台電腦的IP:8080 管理積分等資料；沒設定就不會啟動後台。
# 只在家裡的網路使用，不要把這個連接埠開放到網際網路。
# ADMIN_PASSWORD=請改成你自己的密碼
# ADMIN_PORT=8080

# ===== 選填：開發用 =====
# 開發用伺服器 ID。設定後斜線指令只同步到這個伺服器，修改後會立刻生效
# DEV_GUILD_ID=123456789012345678
